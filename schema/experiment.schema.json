{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/CuiMiles/deeplearning-experiment-ui/schema/experiment.schema.json",
  "title": "Experiment",
  "description": "一个实验的完整记录。由智能体在实验跑完后填写，前端据此渲染图表。字段说明见 AGENTS.md。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "task", "status", "date", "tldr", "brief", "setup", "results"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "与文件名一致，小写、数字、- _ ." },
    "title": { "type": "string", "minLength": 2, "maxLength": 60 },
    "task": { "type": "string", "description": "data/tasks.json 中的任务 id" },
    "status": { "enum": ["completed", "running", "failed", "planned"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string" },
    "series": { "type": "string" },
    "parent": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "author": { "type": "string" },
    "demo": { "type": "boolean" },
    "tldr": { "type": "string", "minLength": 4, "maxLength": 90, "description": "一句话：做了什么 + 结果如何" },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "change", "conclusion", "verdict"],
      "properties": {
        "question": { "type": "string", "maxLength": 80 },
        "change": { "type": "string", "maxLength": 80 },
        "conclusion": { "type": "string", "maxLength": 90 },
        "verdict": { "enum": ["positive", "negative", "mixed", "inconclusive"] },
        "pipeline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "properties": { "label": { "type": "string", "maxLength": 16 }, "changed": { "type": "boolean" }, "note": { "type": "string" } }
          }
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evalData"],
      "properties": {
        "model": { "type": "string" },
        "backbone": { "type": "string" },
        "params": { "type": "string" },
        "trainData": { "type": "array", "items": { "type": "string" } },
        "evalData": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "compute": { "type": "string" },
        "gpuHours": { "type": "number" },
        "frames": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "main"],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "role"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "role": { "enum": ["ours", "baseline", "reference", "ablation"] },
              "note": { "type": "string" }
            }
          }
        },
        "main": { "type": "array", "items": { "$ref": "#/definitions/resultRow" } },
        "headline": {
          "type": "array",
          "items": { "type": "object", "required": ["dataset", "metric"], "additionalProperties": false, "properties": { "dataset": { "type": "string" }, "metric": { "type": "string" } } }
        }
      }
    },
    "curves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "series"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "xLabel": { "type": "string" },
          "yLabel": { "type": "string" },
          "takeaway": { "type": "string" },
          "markers": { "type": "array", "items": { "type": "object", "required": ["x", "label"], "properties": { "x": { "type": "number" }, "label": { "type": "string" } } } },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "data"],
              "additionalProperties": false,
              "properties": { "name": { "type": "string" }, "data": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } } }
            }
          }
        }
      }
    },
    "ablations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "factor", "kind", "metrics", "rows"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "factor": { "type": "string" },
          "kind": { "enum": ["categorical", "numeric"] },
          "metrics": { "type": "array", "items": { "type": "string" } },
          "takeaway": { "type": "string" },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["setting", "metrics"],
              "properties": {
                "setting": { "type": ["string", "number"] },
                "metrics": { "$ref": "#/definitions/metricMap" },
                "isDefault": { "type": "boolean" },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "breakdowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "dimension", "metric", "methods", "buckets"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "dimension": { "type": "string" },
          "metric": { "type": "string" },
          "methods": { "type": "array", "items": { "type": "string" } },
          "takeaway": { "type": "string" },
          "buckets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "values"],
              "additionalProperties": false,
              "properties": { "label": { "type": "string" }, "count": { "type": "number" }, "values": { "$ref": "#/definitions/metricMap" } }
            }
          }
        }
      }
    },
    "charts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "type", "series"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "type": { "enum": ["bar", "line", "scatter", "heatmap", "radar"] },
          "xLabel": { "type": "string" },
          "yLabel": { "type": "string" },
          "categories": { "type": "array", "items": { "type": "string" } },
          "yCategories": { "type": "array", "items": { "type": "string" } },
          "diagonal": { "type": "boolean" },
          "takeaway": { "type": "string" },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "data"],
              "properties": { "name": { "type": "string" }, "data": { "type": "array" } }
            }
          }
        }
      }
    },
    "cases": { "type": "array", "items": { "$ref": "#/definitions/case" } },
    "insights": { "$ref": "#/definitions/insights" },
    "claims": { "type": "array", "items": { "$ref": "#/definitions/claim" } },
    "reproduce": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "repo": { "type": "string" },
        "commit": { "type": "string" },
        "branch": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "hardware": { "type": "string" },
        "commands": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": false, "required": ["label", "cmd"], "properties": { "label": { "type": "string" }, "cmd": { "type": "string" }, "note": { "type": "string" } } }
        },
        "hyperparams": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
        "configFile": { "type": "object", "required": ["name", "content"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "lang": { "type": "string" }, "content": { "type": "string" } } },
        "artifacts": { "type": "array", "items": { "type": "object", "required": ["label", "path"], "additionalProperties": false, "properties": { "label": { "type": "string" }, "path": { "type": "string" } } } }
      }
    }
  },

  "definitions": {
    "metricMap": { "type": "object", "additionalProperties": { "type": "number" } },
    "resultRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "dataset", "metrics"],
      "properties": { "method": { "type": "string" }, "dataset": { "type": "string" }, "metrics": { "$ref": "#/definitions/metricMap" } }
    },
    "segPair": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "box": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 4, "maxItems": 4 },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "src": { "type": "string" }, "poster": { "type": "string" }, "fps": { "type": "number" }, "duration": { "type": "number" } }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src"],
      "properties": { "src": { "type": "string" }, "width": { "type": "number" }, "height": { "type": "number" } }
    },
    "case": {
      "type": "object",
      "required": ["id", "type", "outcome"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["temporal", "dense-caption", "videoqa", "retrieval", "image-grounding", "image-qa", "image-caption"] },
        "title": { "type": "string" },
        "outcome": { "enum": ["success", "failure", "partial"] },
        "note": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "temporal" } } }, "then": { "required": ["video", "query", "gt", "predictions"], "properties": { "video": { "$ref": "#/definitions/video" }, "gt": { "type": "array", "items": { "$ref": "#/definitions/segPair" } }, "sampledFrames": { "type": "array", "items": { "type": "number" } } } } },
        { "if": { "properties": { "type": { "const": "dense-caption" } } }, "then": { "required": ["video", "gt", "predictions"] } },
        { "if": { "properties": { "type": { "const": "videoqa" } } }, "then": { "required": ["video", "question", "answer", "predictions"] } },
        { "if": { "properties": { "type": { "const": "retrieval" } } }, "then": { "required": ["query", "candidates"] } },
        { "if": { "properties": { "type": { "const": "image-grounding" } } }, "then": { "required": ["image", "expression", "gt", "predictions"], "properties": { "image": { "$ref": "#/definitions/image" }, "gt": { "$ref": "#/definitions/box" } } } },
        { "if": { "properties": { "type": { "const": "image-qa" } } }, "then": { "required": ["image", "question", "answer", "predictions"] } },
        { "if": { "properties": { "type": { "const": "image-caption" } } }, "then": { "required": ["image", "references", "predictions"] } }
      ]
    },
    "insights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oneLiner", "phenomena", "echoes", "hypotheses", "paperAngles"],
      "properties": {
        "oneLiner": { "type": "string", "maxLength": 90 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "phenomena": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "surprise"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string", "maxLength": 20 },
              "detail": { "type": "string", "maxLength": 120 },
              "evidence": { "type": "string" },
              "symptoms": { "type": "array", "items": { "type": "string" } },
              "surprise": { "type": "integer", "minimum": 1, "maximum": 5 }
            }
          }
        },
        "echoes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "phenomenon", "borrowedMove"],
            "properties": {
              "id": { "type": "string" },
              "phenomenon": { "type": "string" },
              "lens": { "type": "string" },
              "precedent": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "domain", "story"],
                "properties": { "name": { "type": "string" }, "domain": { "type": "string" }, "year": { "type": "number" }, "people": { "type": "string" }, "story": { "type": "string" }, "ref": { "type": "string" } }
              },
              "correspondences": { "type": "array", "items": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 } },
              "borrowedMove": { "type": "string", "maxLength": 140 },
              "limit": { "type": "string", "maxLength": 120 }
            },
            "anyOf": [{ "required": ["lens"] }, { "required": ["precedent"] }]
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "statement", "test", "impact", "effort"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string", "maxLength": 20 },
              "statement": { "type": "string", "maxLength": 140 },
              "from": { "type": "array", "items": { "type": "string" } },
              "test": { "type": "string", "maxLength": 140 },
              "falsifiedIf": { "type": "string", "maxLength": 120 },
              "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
              "effort": { "type": "integer", "minimum": 1, "maximum": 5 },
              "status": { "enum": ["todo", "running", "confirmed", "refuted"] }
            }
          }
        },
        "paperAngles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "type", "claim"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string", "maxLength": 40 },
              "type": { "enum": ["method", "analysis", "benchmark", "dataset", "theory", "system"] },
              "claim": { "type": "string", "maxLength": 140 },
              "from": { "type": "array", "items": { "type": "string" } },
              "novelty": { "type": "string", "maxLength": 140 },
              "risk": { "type": "string", "maxLength": 140 },
              "venues": { "type": "array", "items": { "type": "string" } },
              "readiness": { "type": "number", "minimum": 0, "maximum": 1 },
              "checkRelated": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "provocations": { "type": "array", "items": { "type": "object", "required": ["prompt", "answer"], "additionalProperties": false, "properties": { "prompt": { "type": "string" }, "answer": { "type": "string", "maxLength": 160 } } } },
        "questionsForYou": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "maxItems": 5 },
        "readingList": { "type": "array", "items": { "type": "object", "required": ["title"], "additionalProperties": false, "properties": { "title": { "type": "string" }, "url": { "type": "string" }, "why": { "type": "string" } } } }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paper", "claim", "reported", "ours", "checklist", "verdict", "decision"],
      "properties": {
        "id": { "type": "string" },
        "paper": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "code"],
          "properties": {
            "title": { "type": "string" },
            "venue": { "type": "string" },
            "year": { "type": "number" },
            "url": { "type": "string" },
            "code": { "enum": ["none", "partial", "full"] },
            "checkpoint": { "type": "boolean" },
            "citations": { "type": "number" }
          }
        },
        "claim": { "type": "string", "maxLength": 120 },
        "setting": { "type": "string" },
        "reported": { "type": "array", "items": { "$ref": "#/definitions/resultRow" } },
        "ours": { "type": "array", "items": { "$ref": "#/definitions/resultRow" } },
        "gap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dataset", "metric", "steps"],
          "properties": {
            "dataset": { "type": "string" },
            "metric": { "type": "string" },
            "steps": { "type": "array", "items": { "type": "object", "required": ["label", "delta"], "additionalProperties": false, "properties": { "label": { "type": "string" }, "delta": { "type": "number" }, "verified": { "type": "boolean" } } } }
          }
        },
        "checklist": {
          "type": "array",
          "items": { "type": "object", "required": ["id", "status"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "status": { "enum": ["pass", "fail", "unknown"] }, "note": { "type": "string" } } }
        },
        "explanations": {
          "type": "array",
          "items": { "type": "object", "required": ["text", "likelihood"], "additionalProperties": false, "properties": { "text": { "type": "string" }, "likelihood": { "type": "integer", "minimum": 1, "maximum": 5 }, "test": { "type": "string" }, "ruledOut": { "type": "boolean" } } }
        },
        "verdict": { "enum": ["reproduced", "partial", "not-reproduced", "contradicted", "pending"] },
        "decision": { "enum": ["build-on", "unverified", "ignore", "contact-authors", "publish-negative"] },
        "timebox": { "type": "string" },
        "action": { "type": "string" }
      }
    }
  }
}
