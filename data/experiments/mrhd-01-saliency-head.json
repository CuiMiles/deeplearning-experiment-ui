  "brief": {
    "question": "一个模型能否同时做好“找片段”和“打高光分”？",
    "change": "新增轻量显著性回归头，联合损失 MR + HD",
    "conclusion": "HD 大幅提升，MR 持平；两者存在轻微竞争",
    "verdict": "positive",
    "pipeline": [
      {
        "label": "视频帧 + 查询"
      },
      {
        "label": "MLLM 编码"
      },
      {
        "label": "片段解码"
      },
      {
        "label": "显著性头",
        "changed": true,
        "note": "对每 2 秒 clip 输出 0–4 分"
      }
    ]
  },
  "setup": {
    "model": "Qwen2.5-VL-7B + 显著性头",
    "params": "7B",
    "trainData": [
      "qvhighlights"
