        "label": "粗采样 16 帧",
        "changed": true
      },
      {
        "label": "输出时间分布",
        "changed": true,
        "note": "让模型输出 Top-5 候选及置信度，作为后验"
      },
      {
        "label": "候选区间加密 16 帧",
        "changed": true
      },
      {
        "label": "RLVR 不思考模型"
      },
      {
        "label": "输出起止秒"
      }
    ]
  },
